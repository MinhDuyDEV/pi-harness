{
  "packages": [
    "npm:@minhduydev/pi-core@0.2.0",
    "npm:@minhduydev/pi-subagents@0.9.0",
    "npm:@minhduydev/pi-todo@0.4.0",
    "npm:@minhduydev/pi-learning@0.4.0"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetryDelayMs": 60000
    }
  },
  "pi-learning": {
    "enabled": true,
    "mode": "auto-safe",
    "autoActivate": true,
    "autoActivation": {
      "enabled": true,
      "allowedKinds": [
        "pattern",
        "discovery"
      ],
      "minEvidenceTrust": "verified-command"
    },
    "retrieval": {
      "maxItems": 3,
      "maxItemChars": 400,
      "maxTotalChars": 1200
    }
  },
  "pi-todo": {
    "enabled": true,
    "widget": true,
    "reminderTurns": 6
  },
  "pi-harness": {
    "profile": "standard"
  }
}
