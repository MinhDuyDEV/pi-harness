{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    ".pi/extensions/*.ts",
    ".pi/extensions/*/index.ts",
    ".pi/extensions/**/*.test.ts",
    ".pi/skills/brave-search/*.js",
    ".pi/skills/browser-tools/*.js",
    "scripts/*.mjs",
    "tests/**/*.ts",
    "types/*.ts"
  ],
  "ignoreDependencies": [
    "@earendil-works/pi-ai",
    "@earendil-works/pi-coding-agent",
    "@earendil-works/pi-tui",
    "@mozilla/readability",
    "cheerio",
    "jsdom",
    "puppeteer",
    "puppeteer-core",
    "puppeteer-extra",
    "puppeteer-extra-plugin-stealth",
    "turndown",
    "turndown-plugin-gfm",
    "typebox"
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.git/**"
  ]
}
