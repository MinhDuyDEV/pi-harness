(deny default)

;; === PROCESS ===
(allow process*)
(allow signal (target self))
(allow sysctl-read)

;; === MACH/IPC ===
(allow mach-lookup)
(allow mach-register)
(allow ipc-posix-shm-read-data)
(allow ipc-posix-shm-write-data)
(allow ipc-posix-shm-write-create)

;; === FILE READ ===
(allow file-read*)

;; === FILE WRITE ===
;; Workspace-write mode: cwd + tmp only
(allow file-write* (subpath "/Users/huynhgiabuu/dev/projects/pikit"))
(allow file-write* (subpath "/var/folders/vc/nqbs096n6mj5g559gj41st5c0000gn/T"))
(allow file-write* (subpath "/tmp"))
(allow file-write* (subpath "/private/tmp"))
(allow file-write* (subpath "/var/folders"))
(allow file-write* (literal "/dev/null"))
(allow file-write* (literal "/dev/tty"))
(allow file-write* (regex #"^/dev/ttys[0-9]+$"))
(allow file-write* (regex #"^/dev/fd/[0-9]+$"))

;; Protected paths — deny even within workspace
(deny file-write* (subpath "/Users/huynhgiabuu/dev/projects/pikit/.git") (with no-log))

;; === NETWORK ===
