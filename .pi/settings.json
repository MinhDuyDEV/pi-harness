{
  "defaultProvider": "agent-router",
  "defaultModel": "glm-5.2",
  "defaultThinkingLevel": "high",
  "editorPaddingX": 0,
  "images": {
    "blockImages": false
  },
  "packages": [
    "npm:@heyhuynhgiabuu/pi-pretty",
    "npm:@heyhuynhgiabuu/pi-diff",
    "npm:@heyhuynhgiabuu/pi-search",
    "npm:@heyhuynhgiabuu/pi-task",
    "git:https://github.com/badlogic/pi-diff-review"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "branchSummary": {
    "reserveTokens": 16384
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetryDelayMs": 60000
    }
  },
  "steeringMode": "one-at-a-time",
  "followUpMode": "one-at-a-time",
  "enableSkillCommands": true,
  "skills": [
    ".pi/skills/"
  ],
  "prompts": [
    ".pi/prompts/"
  ],
  "extensions": [
    ".pi/extensions/"
  ],
  "lastChangelogVersion": "0.80.3",
  "treeFilterMode": "default",
  "transport": "auto",
  "hideThinkingBlock": true,
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": true,
    "showImages": false,
    "autoResize": true
  },
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "powerline": {
    "preset": "default",
    "fixedEditor": true
  },
  "piTui": {
    "workingPaddingTop": 1
  },
  "theme": "catppuccin",
  "showHardwareCursor": false,
  "autocompleteMaxVisible": 10,
  "quietStartup": false,
  "doubleEscapeAction": "tree",
  "defaultProjectTrust": "always",
  "outputPad": 1
}