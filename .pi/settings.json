{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.4",
  "defaultThinkingLevel": "high",
  "theme": "catppuccin",
  "editorPaddingX": 0,
  "images": {
    "blockImages": false
  },
  "packages": [
    "npm:@tintinweb/pi-subagents",
    "npm:@tintinweb/pi-tasks",
    "npm:pi-teams",
    "npm:pi-mcp-adapter",
    "git:github.com/ghoseb/pi-askuserquestion",
    "npm:@aliou/pi-guardrails",
    "https://github.com/badlogic/pi-diff-review",
    "npm:pi-image-preview",
    "npm:@marckrenn/pi-sub-bar",
    "npm:pi-rewind",
    "npm:pi-notify",
    "npm:@heyhuynhgiabuu/pi-diff",
    "npm:@heyhuynhgiabuu/pi-pretty",
    "npm:@heyhuynhgiabuu/pi-search"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "branchSummary": {
    "reserveTokens": 16384
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "maxDelayMs": 60000
  },
  "steeringMode": "one-at-a-time",
  "followUpMode": "one-at-a-time",
  "enableSkillCommands": true,
  "skills": [
    ".pi/skills/"
  ],
  "prompts": [
    ".pi/prompts/"
  ],
  "extensions": [
    ".pi/extensions/"
  ],
  "lastChangelogVersion": "0.67.68",
  "treeFilterMode": "default",
  "transport": "sse",
  "hideThinkingBlock": false
}