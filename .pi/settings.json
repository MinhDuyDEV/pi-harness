{
  "defaultProvider": "github-copilot",
  "defaultModel": "claude-opus-4.6",
  "defaultThinkingLevel": "high",
  "theme": "dark",
  "editorPaddingX": 0,
  "images": {
    "blockImages": true
  },
  "packages": [
    "npm:@tintinweb/pi-subagents",
    "npm:pi-teams",
    "npm:pi-mcp-adapter",
    "git:github.com/ghoseb/pi-askuserquestion",
    "npm:@aliou/pi-guardrails",
    "https://github.com/badlogic/pi-diff-review",
    "npm:@tintinweb/pi-tasks",
    "npm:pi-rewind",
    "npm:pi-notify"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "branchSummary": {
    "reserveTokens": 16384
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "maxDelayMs": 60000
  },
  "steeringMode": "one-at-a-time",
  "followUpMode": "one-at-a-time",
  "enableSkillCommands": true,
  "skills": [".pi/skills/"],
  "prompts": [".pi/prompts/"],
  "extensions": [".pi/extensions/"]
}
