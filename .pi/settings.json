{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-terra",
  "defaultThinkingLevel": "high",
  "editorPaddingX": 1,
  "images": {
    "blockImages": false
  },
  "packages": [
    "npm:@heyhuynhgiabuu/pi-pretty",
    "npm:@heyhuynhgiabuu/pi-diff",
    "npm:@heyhuynhgiabuu/pi-search@0.2.7",
    "npm:@heyhuynhgiabuu/pi-task",
    "git:https://github.com/badlogic/pi-diff-review"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "branchSummary": {
    "reserveTokens": 16384
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetryDelayMs": 60000
    }
  },
  "steeringMode": "all",
  "followUpMode": "all",
  "enableSkillCommands": true,
  "skills": [
    ".pi/skills/"
  ],
  "prompts": [
    ".pi/prompts/"
  ],
  "extensions": [
    ".pi/extensions/"
  ],
  "lastChangelogVersion": "0.80.6",
  "treeFilterMode": "default",
  "transport": "auto",
  "hideThinkingBlock": false,
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": true,
    "showImages": false,
    "autoResize": true
  },
  "collapseChangelog": false,
  "enableInstallTelemetry": false,
  "powerline": {
    "preset": "default"
  },
  "piTui": {
    "workingPaddingTop": 1,
    "fixedEditor": {
      "enabled": false
    }
  },
  "theme": "catppuccin",
  "showHardwareCursor": false,
  "autocompleteMaxVisible": 10,
  "quietStartup": false,
  "doubleEscapeAction": "tree",
  "defaultProjectTrust": "always",
  "outputPad": 1,
  "showCacheMissNotices": true
}