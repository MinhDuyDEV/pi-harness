{
  "packages": [
    "npm:@minhduydev/pi-core@0.3.1",
    "npm:@minhduydev/pi-subagents@0.12.0",
    "npm:@minhduydev/pi-todo@0.6.0",
    "npm:@minhduydev/pi-learning@0.6.0",
    "npm:@heyhuynhgiabuu/pi-search@0.3.0",
    "npm:@sting8k/pi-srcwalk@1.2.8",
    "npm:@mrclrchtr/supi-ask-user@4.0.0"
  ],
  "pi-learning": {
    "enabled": true,
    "mode": "auto-safe",
    "autoActivate": true,
    "autoActivation": {
      "enabled": true,
      "allowedKinds": ["pattern", "discovery"],
      "minEvidenceTrust": "verified-command"
    },
    "retrieval": {
      "maxItems": 3,
      "maxItemChars": 400,
      "maxTotalChars": 1200
    }
  },
  "pi-todo": {
    "enabled": true,
    "widget": false,
    "autoArchive": true,
    "reminderTurns": 6
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "branchSummary": {
    "reserveTokens": 16384
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetryDelayMs": 60000
    }
  },
  "steeringMode": "all",
  "followUpMode": "all",
  "enableSkillCommands": true,
  "pi-harness": {
    "profile": "full",
    "superpi": true,
    "gptPersonality": true,
    "extensions": {
      "safety": false,
      "herdrState": true,
      "shortcutContinue": true,
      "checkpoint": true,
      "rewind": true,
      "learningCoordinator": true,
      "workflowState": true,
      "dcp": true,
      "continueAfterCompaction": true,
      "tps": true,
      "diagnostics": true,
      "integration": true,
      "usageTracker": true,
      "snapEdit": true
    }
  }
}
