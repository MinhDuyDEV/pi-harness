{
	"name": "pikit",
	"type": "module",
"bin": "./bin/cli.js",
	"version": "1.0.0",
	"description": "Batteries-included pi coding agent kit — extensions, agents, skills, prompts, and themes",
	"keywords": ["pi-package"],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/huynhgiabuu/pikit"
	},
	"scripts": {
		"start": "node scripts/serve-workbench.mjs",
		"test": "node --test",
		"postinstall": "cd .pi/extensions && npm install --ignore-scripts && npm rebuild better-sqlite3 && npm rebuild sqlite-vec",
		"sync:behavioral-kernel": "node scripts/sync-behavioral-kernel.mjs",
		"check:behavioral-kernel": "node scripts/sync-behavioral-kernel.mjs --check",
		"install:hooks": "node scripts/install-git-hooks.mjs",
		"validate:skills": "node scripts/validate-skills.mjs",
		"validate:skills:strict": "node scripts/validate-skills.mjs --strict",
		"validate:skills:ci": "node scripts/validate-skills.mjs --check",
		"validate": "npm run validate:skills",
		"setup": "npm run install:hooks && echo 'Ready.'"
	},
	"pi": {
		"extensions": [".pi/extensions"],
		"skills": [".pi/skills"],
		"prompts": [".pi/prompts"],
		"themes": [".pi/themes"]
	}
}
