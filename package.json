{
	"name": "pikit",
	"type": "module",
	"bin": "./bin/cli.js",
	"version": "1.0.0",
	"description": "Batteries-included pi coding agent kit — extensions, agents, skills, prompts, and themes",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/huynhgiabuu/pikit"
	},
	"devDependencies": {
		"typescript": "^5.9.3"
	},
	"scripts": {
		"start": "node scripts/serve-workbench.mjs",
		"test": "npm run test:extensions",
		"test:extensions": "node scripts/run-extension-tests.mjs",
		"test:safety": "npx tsx .pi/extensions/safety/safety.test.ts",
		"typecheck": "tsc --noEmit",
		"postinstall": "cd .pi/extensions && npm install --ignore-scripts && npm rebuild better-sqlite3",
		"install:hooks": "node scripts/install-git-hooks.mjs",
		"setup": "npm run install:hooks && echo 'Ready.'"
	},
	"pi": {
		"extensions": [
			".pi/extensions"
		],
		"skills": [
			".pi/skills"
		],
		"prompts": [
			".pi/prompts"
		],
		"themes": [
			".pi/themes"
		]
	}
}
