{
  "name": "@minhduydev/pi-harness",
  "version": "2.3.2",
  "private": false,
  "bin": {
    "pi-harness-init": "./scripts/init-consumer.mjs"
  },
  "description": "A portable Pi Coding Agent package with curated extensions, skills, prompts, and themes.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "check": "npm run validate:skills && npm run package:check && npm run smoke:resources && npm run smoke:packed && npm run typecheck && npm run typecheck:extensions && npm run typecheck:extension-tests && npm run quality && npm run test:all",
    "test": "npm run test:all",
    "test:all": "npm run test:extensions && npm run test:skills",
    "test:extensions": "node scripts/run-extension-tests.mjs .pi/extensions",
    "verify:auto-safe": "node --import tsx scripts/verify-auto-safe-e2e.ts",
    "verify:phase5-packed": "node --import tsx scripts/verify-phase5-packed-e2e.ts",
    "test:skills": "node scripts/run-extension-tests.mjs tests",
    "test:safety": "node scripts/run-extension-tests.mjs .pi/extensions/safety",
    "test:tui": "node scripts/run-extension-tests.mjs .pi/extensions/tui",
    "typecheck": "tsc --noEmit",
    "typecheck:extensions": "tsc --noEmit -p .pi/extensions/tsconfig.json",
    "typecheck:extension-tests": "tsc --noEmit -p .pi/extensions/tsconfig.tests.json",
    "validate:skills": "node scripts/generate-superpi-router.mjs --check && node scripts/validate-skills.mjs",
    "generate:superpi": "node scripts/generate-superpi-router.mjs",
    "regen:skills": "node scripts/validate-skills.mjs --update",
    "validate:skills:ci": "npm run validate:skills",
    "package:check": "node scripts/validate-package.mjs",
    "quality": "npm run quality:fallow && npm run quality:ratchet && npm run quality:aislop",
    "quality:fallow": "fallow dead-code",
    "quality:ratchet": "node scripts/quality-ratchet.mjs",
    "quality:ratchet:update": "node scripts/quality-ratchet.mjs --update",
    "quality:aislop": "aislop ci --changes --human",
    "smoke:resources": "node scripts/smoke-resources.mjs",
    "smoke:packed": "node scripts/smoke-packed-resources.mjs",
    "benchmark:full": "node scripts/benchmark-full-profile.mjs",
    "validate:package-payload": "node scripts/validate-package-payload.mjs",
    "pack:check": "npm run validate:package-payload",
    "registry:preflight": "node scripts/registry-preflight.mjs",
    "release:check": "npm run release:check:local",
    "release:check:local": "node scripts/release-check.mjs --mode=local",
    "release:check:offline": "node scripts/release-check.mjs --mode=local --offline",
    "release:check:registry": "node scripts/release-check.mjs --mode=registry",
    "prepublishOnly": "npm run release:check:registry"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MinhDuyDEV/pi-harness.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "extensions",
    "skills"
  ],
  "author": "minhduydev <minhduy.dev@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "AGENTS.md",
    "README.md",
    "PROJECT.md",
    "quality",
    "skills-lock.json",
    "scripts",
    "templates",
    "docs",
    "tsconfig.json",
    "package.json",
    ".pi/DESIGN.md",
    ".pi/README.md",
    ".pi/settings.json",
    ".pi/APPEND_SYSTEM.md",
    ".pi/ANTI_PATTERNS.md",
    ".pi/agents",
    ".pi/extensions",
    ".pi/prompts",
    ".pi/skills",
    ".pi/templates",
    ".pi/themes",
    "!**/*.test.ts",
    "!**/*.test.js",
    "!**/*.test.d.ts",
    "!.pi/extensions/rewind/PORT.md",
    "!.pi/extensions/rewind/TESTING.md"
  ],
  "pi": {
    "extensions": [
      "./.pi/extensions"
    ],
    "skills": [
      "./.pi/skills"
    ],
    "prompts": [
      "./.pi/prompts"
    ],
    "themes": [
      "./.pi/themes"
    ]
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "adm-zip": "0.6.0",
    "protobufjs": "7.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.81.1 <0.82.0",
    "@earendil-works/pi-coding-agent": ">=0.81.1 <0.82.0",
    "@earendil-works/pi-tui": ">=0.81.1 <0.82.0",
    "@minhduydev/pi-core": "^0.3.0",
    "@minhduydev/pi-learning": ">=0.5.0 <0.6.0",
    "@minhduydev/pi-subagents": ">=0.11.0 <0.12.0",
    "@minhduydev/pi-todo": ">=0.4.0 <0.5.0",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.81.1",
    "@earendil-works/pi-coding-agent": "0.81.1",
    "@earendil-works/pi-tui": "0.81.1",
    "@minhduydev/pi-core": "file:../pi-core",
    "@minhduydev/pi-todo": "file:../pi-todo",
    "@types/node": "^24.0.0",
    "aislop": "0.13.1",
    "bun-types": "1.3.10",
    "fallow": "3.7.1",
    "tsx": "4.23.1",
    "typebox": "1.1.38",
    "typescript": "^5.9.3"
  },
  "peerDependenciesMeta": {
    "@minhduydev/pi-subagents": {
      "optional": true
    },
    "@minhduydev/pi-learning": {
      "optional": true
    },
    "@minhduydev/pi-todo": {
      "optional": true
    },
    "@minhduydev/pi-core": {}
  }
}
